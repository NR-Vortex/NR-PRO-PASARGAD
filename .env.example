# NRX VPN - Development example only. NEVER commit .env with secrets.
APP_NAME="NRX VPN"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

# Telegram - leave empty unless testing against a dedicated test bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_WEBHOOK_SECRET=

# Optional PasarGuard integration (not required for local health check)
PASARGUARD_BASE_URL=
PASARGUARD_API_TOKEN=

# PostgreSQL - use an isolated development database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nr_pro_pasargad
DB_USERNAME=
DB_PASSWORD=
# For local development only; use verified TLS settings in production
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=5

# Redis - default local development service; do not expose publicly
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DATABASE=0
REDIS_PASSWORD=
REDIS_TIMEOUT=3
QUEUE_NAME=default

# Panel credential encryption - generate and store privately before panel use
NR_PANEL_ENCRYPTION_KEY=

# Database write safety - do not enable for ordinary development setup
NR_PANEL_STATUS_WRITE_ENABLED=0
NR_PANEL_STATUS_WRITE_ACK=
